# ─────────────────────────────────────────────────────────────────────────
# EmailJS — contact form delivery (https://www.emailjs.com)
#
# These values are PUBLIC by design (they run in the browser). Copy this file
# to `.env.local` for local dev, and set the SAME three variables in Vercel:
#   Project → Settings → Environment Variables → (Production + Preview), then redeploy.
#
# Setup:
#   1. Create an EmailJS account and add an Email Service (connect the mailbox
#      you want inquiries delivered to, e.g. office@sns-austria.com).
#   2. Create an Email Template. It should reference these variables — they
#      match the contact form's field `name`s exactly:
#        {{name}}     – sender's name
#        {{email}}    – sender's email   (set the template's Reply-To to {{email}})
#        {{phone}}    – sender's phone (may be blank)
#        {{service}}  – type of service selected
#        {{message}}  – the message
#      Set the template's "To" address to office@sns-austria.com.
#   3. Copy the Service ID, Template ID, and Public Key into the vars below.
#   4. In EmailJS, turn on anti-abuse: add reCAPTCHA to the template and/or
#      restrict allowed domains to your site (keys are public, so this matters).
#
# Until these are set, the form gracefully falls back to opening the visitor's
# email client (mailto) so it's never a dead end.
# ─────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Consultation booking — Google Calendar + Google Meet (server only, NEVER NEXT_PUBLIC_)
#
# The booking widget (components/booking/BookingWidget.tsx) reads free times from
# /api/booking/slots and books through /api/booking. A Google Workspace service
# account with domain-wide delegation acts as BOOKING_ORGANIZER: it reads free/busy,
# creates the event with a Meet link, and Google emails the invitation.
# Setup steps: docs/booking-setup.md. Without these, the widget shows the email address.
# Local development without Google: BOOKING_MOCK=1 (fake calendar, nothing is booked).
# ─────────────────────────────────────────────────────────────────────────

GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
BOOKING_ORGANIZER=office@sns-austria.com
# calendars whose meetings block a slot (comma-separated); defaults to the organizer
BOOKING_BUSY_CALENDARS=
# optional, these are the defaults:
# BOOKING_TIMEZONE=Europe/Vienna
# BOOKING_HOURS=09:00-12:00,13:30-16:30
# BOOKING_DAYS=1-5
# BOOKING_LENGTH=30
# BOOKING_BUFFER=15
# BOOKING_NOTICE_HOURS=18
# BOOKING_WINDOW_DAYS=42
# BOOKING_MOCK=1
